  careerEvent            CareerEvent?       @relation(fields: [career_event_id], references: [id], onUpdate: NoAction, map: "career_event_option_career_event_career_event_id_foreign")

  @@map("career_event_option_events")
}

model CareerEventOptionSubOption {
  id                     Int                @id(map: "career_event_option_career_sub_option_pkey") @default(autoincrement())
  career_event_option_id String?            @db.Uuid
  career_sub_option_id   Int?
  careerSubOption        CareerSubOption?   @relation(fields: [career_sub_option_id], references: [id], onUpdate: NoAction, map: "career_event_option_career_sub_option_care__1e69f958_foreign")
  careerEventOption      CareerEventOption? @relation(fields: [career_event_option_id], references: [id], onUpdate: NoAction, map: "career_event_option_career_sub_option_care__743ffebe_foreign")

  @@map("career_event_option_sub_options")
}

model CareerEventOption {
  id                          String                       @id(map: "career_event_option_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date_created                DateTime?                    @db.Timestamptz(6)
