  speaker              Speaker?         @relation(fields: [speaker_id], references: [id], onUpdate: NoAction, map: "career_event_page_speaker_speaker_id_foreign")

  @@map("career_event_page_speakers")
}

model CareerEventPageTimetable {
  id                   Int              @id(map: "career_event_page_timetable_pkey") @default(autoincrement())
  career_event_page_id Int?
  timetable_id         Int?
  careerEventPage      CareerEventPage? @relation(fields: [career_event_page_id], references: [id], onUpdate: NoAction, map: "career_event_page_timetable_career_event_page_id_foreign")
  timetable            Timetable?       @relation(fields: [timetable_id], references: [id], onUpdate: NoAction, map: "career_event_page_timetable_timetable_id_foreign")

  @@map("career_event_page_timetables")
}

model CareerEventPage {
  id                        Int                        @id(map: "career_event_page_pkey") @default(autoincrement())
  status                    String                     @default("draft") @db.VarChar(255)
  event_id                  String?                    @db.Uuid
  shout                     String?                    @db.VarChar(255)
  description_EN            String?
  tagline                   String?                    @db.VarChar(255)
  address                   String?                    @db.VarChar(255)
  parking                   String?                    @db.VarChar(255)
  registration_link         String?                    @db.VarChar(255)
  floorplan_id              Int?
  image_id                  String?                    @db.Uuid
  company_guide             String?                    @db.Uuid
  header_buttons            Json?
  latitude                  Float?
  longitude                 Float?
  careerEventPageCompanies  CareerEventPageCompany[]
  careerEventPageSpeakers   CareerEventPageSpeaker[]
  careerEventPageTimetables CareerEventPageTimetable[]
  companyGuide              File?                      @relation("career_event_pages_company_guideTofiles", fields: [company_guide], references: [id], onUpdate: NoAction, map: "career_event_page_company_guide_foreign")
  event                     CareerEvent?               @relation(fields: [event_id], references: [id], onUpdate: NoAction, map: "career_event_page_event_foreign")
  floorplan                 Floorplan?                 @relation(fields: [floorplan_id], references: [id], onUpdate: NoAction, map: "career_event_page_floorplan_foreign")
  image                     File?                      @relation("career_event_pages_image_idTofiles", fields: [image_id], references: [id], onUpdate: NoAction, map: "career_event_page_image_foreign")
  timetableCareerEventPages TimetableCareerEventPage[]

  @@map("career_event_pages")
}

model CareerEvent {
  id                      String                   @id(map: "career_event_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                  String                   @default("draft") @db.VarChar(255)
  date_created            DateTime?                @db.Timestamptz(6)
  date_updated            DateTime?                @db.Timestamptz(6)
  name                    String?
  description             String?
  location                String?                  @db.VarChar(255)
  date                    DateTime?                @db.Date
  end_hour                DateTime?                @db.Time(6)
  start_hour              DateTime?                @db.Time(6)
  num_of_companies        Int?
  num_of_students         Int?
  image_id                String?                  @db.Uuid
  shout                   String?                  @db.VarChar(255)
  careerEventOptionEvents CareerEventOptionEvent[]
  careerEventPages        CareerEventPage[]
  image                   File?                    @relation(fields: [image_id], references: [id], onUpdate: NoAction, map: "career_event_image_foreign")
  matchingSoftwares       MatchingSoftware[]
  schedules               Schedule[]

  @@map("career_events")
}

model CareerSubOption {
  id                          Int                          @id(map: "career_sub_option_pkey") @default(autoincrement())
  date_updated                DateTime?                    @db.Timestamptz(6)
  name                        String?                      @db.VarChar(255)
  description                 String?
  price                       String?                      @db.VarChar(255)
