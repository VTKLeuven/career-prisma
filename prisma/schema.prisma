  @@map("career_sub_options")
}

model Company {
  id                               String                           @id(map: "company_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                           String                           @default("draft") @db.VarChar(255)
  date_created                     DateTime?                        @db.Timestamptz(6)
  date_updated                     DateTime?                        @db.Timestamptz(6)
  name                             String?                          @db.VarChar(255)
  salesperson_id                   String?                          @db.Uuid
  VAT                              String?                          @db.VarChar(255)
  address_street                   String?                          @db.VarChar(255)
  address_number                   String?                          @db.VarChar(255)
  address_zip                      String?                          @db.VarChar(255)
  address_city                     String?                          @db.VarChar(255)
  address_country                  String?                          @db.VarChar(255)
  logo_id                          String?                          @db.Uuid
  short_description                String?
  long_description                 String?
  location                         String?                          @db.VarChar(255)
  website                          String?                          @db.VarChar(255)
  page_image                       String?                          @db.Uuid
  booths                           Booth[]
  careerEventPageCompanies         CareerEventPageCompany[]
  logo                             File?                            @relation("companies_logo_idTofiles", fields: [logo_id], references: [id], onUpdate: NoAction, map: "company_logo_foreign")
  pageImage                        File?                            @relation("companies_page_imageTofiles", fields: [page_image], references: [id], onUpdate: NoAction, map: "company_page_image_foreign")
  salesperson                      User?                            @relation("companies_salesperson_idTousers", fields: [salesperson_id], references: [id], onUpdate: NoAction, map: "company_salesperson_foreign")
  companyCareerEventOptions        CompanyCareerEventOption[]
  companyCareerSubOptions          CompanyCareerSubOption[]
  companyMasters                   CompanyMaster[]
  companyMatchingResponses         CompanyMatchingResponse[]
  companyUserRequests              CompanyUserRequest[]
  cvBookFavourites                 CvBookFavourite[]
  formResponses                    FormResponse[]
  studentMatchingResponseCompanies StudentMatchingResponseCompany[]
  studentCompanies                 StudentCompany[]
  users                            User[]                           @relation("users_company_idTocompanies")
  vacancies                        Vacancy[]

  @@map("companies")
}

