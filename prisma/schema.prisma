generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AcademicYear {
  id                Int                @id(map: "Academic_Year_pkey") @default(autoincrement())
  date_created      DateTime?          @db.Timestamptz(6)
  date_updated      DateTime?          @db.Timestamptz(6)
  start_of_year     DateTime?          @db.Timestamp(6)
  name              String?            @db.VarChar(255)
  end_of_year       DateTime?          @db.Timestamp(6)
  cvBooks           CvBook[]
  matchingSoftwares MatchingSoftware[]

  @@map("academic_years")
}

model AttendantScan {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendant_uuid      String?       @db.VarChar(255)
  form_response_id    Int?
  company_id          Int?
  scanned_by          String?       @db.Uuid
  scanned_at          DateTime?     @db.Timestamptz(6)
  liked               Boolean       @default(false)
  comment             String?       @db.VarChar(255)
  feedback_updated_at DateTime?     @db.Timestamp(6)
  formResponse        FormResponse? @relation(fields: [form_response_id], references: [id], onUpdate: NoAction, map: "attendant_scans_form_response_id_foreign")
  scannedBy           User?         @relation(fields: [scanned_by], references: [id], onUpdate: NoAction, map: "attendant_scans_scanned_by_foreign")

  @@map("attendant_scans")
}

model Booth {
  id           Int         @id(map: "Booths_pkey") @default(autoincrement())
  coords       Json?
  floorplan_id Int?
  company_id   String?     @db.Uuid
  booth_number Int?
  company      Company?    @relation(fields: [company_id], references: [id], onUpdate: NoAction, map: "booths_company_foreign")
  floorplan    Floorplan?  @relation(fields: [floorplan_id], references: [id], onUpdate: NoAction, map: "booths_floorplan_foreign")
  orders       Order[]
  zoneBooths   ZoneBooth[]

  @@map("booths")
}

model CareerEventOptionEvent {
  id                     Int                @id(map: "career_event_option_career_event_pkey") @default(autoincrement())
  career_event_option_id String?            @db.Uuid
  career_event_id        String?            @db.Uuid
