}

model CareerEventPageCompany {
  id                   Int              @id(map: "career_event_page_company_pkey") @default(autoincrement())
  career_event_page_id Int?
  company_id           String?          @db.Uuid
  careerEventPage      CareerEventPage? @relation(fields: [career_event_page_id], references: [id], onUpdate: NoAction, map: "career_event_page_company_career_event_page_id_foreign")
  company              Company?         @relation(fields: [company_id], references: [id], onUpdate: NoAction, map: "career_event_page_company_company_id_foreign")

  @@map("career_event_page_companies")
}

model CareerEventPageSpeaker {
  id                   Int              @id(map: "career_event_page_speaker_pkey") @default(autoincrement())
  career_event_page_id Int?
  speaker_id           Int?
