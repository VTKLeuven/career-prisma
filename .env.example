# Copy to .env and fill in. See SETUP.md.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Used by the app and by the Prisma CLI. Inside Docker the app overrides this
# to reach the database by service name, so this value only needs to be right
# for host-side work (prisma migrate, psql).
DATABASE_URL="postgresql://career:CHANGEME@localhost:5434/career?schema=public"

# Consumed by the `database` service in docker-compose.yml.
POSTGRES_USER=career
POSTGRES_PASSWORD=
POSTGRES_DB=career
POSTGRES_PORT=5434

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=

KULEUVEN_CLIENT_ID=
KULEUVEN_CLIENT_SECRET=
KULEUVEN_ISSUER=

LITUS_OAUTH_AUTHORIZE=
LITUS_OAUTH_TOKEN=
LITUS_OAUTH_RESOURCE_OWNER_DETAILS=
LITUS_API_KEY=

# ---------------------------------------------------------------------------
# Mail (Google Workspace SMTP relay)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_EMAIL=
SMTP_HELO_NAME=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORM_DOMAIN=
CHECKIN_API_KEY=
# Absolute path in production. Defaults to ./directus-uploads for local work.
UPLOADS_DIR=

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLE_REPLAY=
# SENTRY_AUTH_TOKEN=   # only needed for source map uploads

# k6 stress test credentials (loaded when running k6)
K6_COMPANY_REP_EMAIL=
K6_COMPANY_REP_PASSWORD=
K6_STUDENT_EMAIL=
K6_STUDENT_PASSWORD=
