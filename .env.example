# Copy to .env and fill in. See SETUP.md.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Used for host-side Prisma CLI work. Inside Docker the app uses separate
# DATABASE_* fields generated by Compose. URL-encode special characters in this
# URL's password (for example, @ becomes %40).
DATABASE_URL="postgresql://career:CHANGEME@localhost:5437/career?schema=public"

# Consumed by the `database` service in docker-compose.yml.
POSTGRES_USER=career
# Wrap passwords containing $, #, or whitespace in single quotes.
POSTGRES_PASSWORD=
POSTGRES_DB=career
POSTGRES_PORT=5437
APP_PORT=3003

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=

# VTK SSO (OpenID Connect on the new vtk.be site, better-auth's SSO provider).
# Replaced the LITUS_* variables the old site used. The issuer is the base URL
# the discovery document sits under: <issuer>/.well-known/openid-configuration.
VTK_SSO_ISSUER=
VTK_SSO_CLIENT_ID=
VTK_SSO_CLIENT_SECRET=
# Optional. Defaults to <origin>/api/auth/oauth/callback — set it only when the
# redirect URI registered with the SSO differs from what the app derives.
VTK_SSO_CALLBACK_URL=
# Optional. Space- or comma-separated; overrides the default scope set in
# src/lib/vtk-sso.ts. Leave empty unless you know why you are narrowing it.
VTK_SSO_SCOPES=

# ---------------------------------------------------------------------------
# Mail (Google Workspace SMTP relay)
# Left empty, production sends through smtp-relay.gmail.com (IP-allowlisted).
# A development server with neither SMTP_HOST nor SMTP_USER set logs each
# email instead of sending it, and with DEV_ENVIRONMENT=true (the dev site) no
# email is ever sent, whatever is set here.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_EMAIL=
SMTP_HELO_NAME=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORM_DOMAIN=
CHECKIN_API_KEY=
# Absolute path in production. Defaults to ./directus-uploads for local work.
UPLOADS_DIR=

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLE_REPLAY=
# SENTRY_AUTH_TOKEN=   # only needed for source map uploads

# k6 stress test credentials (loaded when running k6)
K6_COMPANY_REP_EMAIL=
K6_COMPANY_REP_PASSWORD=
K6_STUDENT_EMAIL=
K6_STUDENT_PASSWORD=

# ---------------------------------------------------------------------------
# Environment flag
# "true" on dev.career.vtk.be, "false" (or unset) on career.vtk.be.
# Gates features that are demo-ready but not production-ready, currently the
# vacancies / job platform. Compose passes it both as a build arg and as a
# runtime variable -- keep the two equal. Anything other than "true" counts
# as production.
# ---------------------------------------------------------------------------
DEV_ENVIRONMENT=false

# ---------------------------------------------------------------------------
# Local development seed (scripts/seed-dev-data.mjs)
# Never set these on a deployed environment: the script writes a working
# administrator account with this password.
# ---------------------------------------------------------------------------
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Optional. Both default to the admin password if left blank.
DEV_REP_EMAIL=
DEV_REP_PASSWORD=
DEV_STUDENT_EMAIL=
DEV_STUDENT_PASSWORD=
