# Allow skipping the build for emergency pushes
if [ -n "$HUSKY_SKIP_BUILD" ]; then
  echo "[husky] Skipping build due to HUSKY_SKIP_BUILD=1"
  exit 0
fi

echo "[husky] Running npm run build -s before push..."
# Run build in silent mode to reduce noise
npm run build -s
status=$?
if [ $status -ne 0 ]; then
  echo "[husky] Build failed. Aborting push."
  exit $status
fi

exit 0
